# Reference only: process environment is read; .env is not loaded automatically.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Confirm a Free Tier project without linked billing before setting this to 1.
GEMINI_FREE_TIER_CONFIRMED=0
# For Ollama use LLM_PROVIDER=ollama and LLM_MODEL=qwen3:4b.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set this in the Ollama server environment before starting it.
OLLAMA_NO_CLOUD=1
EMPORIO_RUN_LIVE=0
